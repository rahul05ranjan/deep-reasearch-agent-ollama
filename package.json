{
  "name": "smart-research-assistant",
  "version": "1.0.0",
  "description": "An AI-powered research assistant using Ollama",
  "main": "dist/src/index.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node dist/src/index.js",
    "dev": "tsx watch src/index.ts",
    "research": "node dist/src/index.js",
    "demo": "node dist/src/index.js --demo",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "tsx --test src/__tests__/*.test.*",
    "web": "node dist/server.js",
    "web-dev": "tsx watch server.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "keywords": [
    "ai",
    "ollama",
    "langchain",
    "research",
    "assistant"
  ],
  "author": "AI Assistant",
  "license": "MIT",
  "dependencies": {
    "boxen": "^7.1.1",
    "chalk": "^5.3.0",
    "dompurify": "^3.0.5",
    "express": "^4.18.2",
    "inquirer": "^9.2.12",
    "marked": "^9.1.2",
    "ollama": "^0.5.9",
    "ora": "^8.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/inquirer": "^9.0.10",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
